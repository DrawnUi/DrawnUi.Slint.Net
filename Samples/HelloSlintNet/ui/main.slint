import { DrawnUiView } from "drawnui.slint";
export { DrawnUiHost } from "drawnui.slint";

// The whole window is one DrawnUI view, as the other Hello apps' windows are one canvas.
export component MainWindow inherits Window {
    title: "DrawnUI for Slint.NET";
    icon: @image-url("../images/drawnui.svg");
    preferred-width: 980px;
    preferred-height: 820px;
    background: #212529;
    // keys reach the drawn pages at once, without a click first
    forward-focus: view;

    view := DrawnUiView {
        view-id: 0;
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
    }
}
